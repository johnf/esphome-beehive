	(text "FeatherS3D on female headers (Unexpected Maker pinout card)\nJ2, USB-end row: 1 RST, 2 3V3, 3 IO0, 4 GND, 5 IO17, 6 IO18, 7 IO14, 8 IO12,\n  9 IO6 (DONE), 10 IO5 (CHRG), 11 IO36, 12 IO35, 13 IO37, 14 IO44/RX, 15 IO43/TX, 16 LDO2 (+3V3)\nJ3, opposite row: 1 IO8/SDA, 2 IO9/SCL, 3 IO33, 4 IO38, 5 IO1 (WS), 6 IO3 (SCK),\n  7 IO7 (SD), 8 IO10, 9 IO11, 10 5V, 11 EN, 12 VBAT\nJ3 pin 1 sits opposite J2 pin 16; J3 pin 12 opposite J2 pin 5."
		(exclude_from_sim no)
		(at 25.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5974520-4768-479c-830b-ff445abb28f6")
	)
